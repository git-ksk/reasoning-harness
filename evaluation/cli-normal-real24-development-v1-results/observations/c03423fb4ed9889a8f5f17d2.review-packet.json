    "rw-02-b": {
      "source_id": "rw-02-b",
      "document_id": "curl-2",
      "url": "https://raw.githubusercontent.com/curl/curl/7eb8c048470ed2cc14dca75be9c1cdae7ac8498b/docs/cmdline-opts/retry-all-errors.md",
      "normalized_path": "normalized/curl-2.txt",
      "raw_sha256": "a98f60938760f9d35232b3da2f7b45da4aa239411a142a52e5e8dccf6a5fb916",
      "normalized_sha256": "4f81c7efbe90b7701f44c8643b804258ec872e52df927cd0d04224c67f220ab1",
      "source_version": "sha256:a98f60938760f9d35232b3da2f7b45da4aa239411a142a52e5e8dccf6a5fb916",
      "retrieved_at_unix_seconds": 1792409895,
      "start_byte": 1231,
      "end_byte": 1753,
      "quote": "By default curl does not return error for transfers with an HTTP response code that indicates an HTTP error, if the transfer was successful. For example, if a server replies 404 Not Found and the reply is fully received then that is not an error. When --retry is used then curl retries on some HTTP response codes that indicate transient HTTP errors, but that does not include most 4xx response codes such as 404. If you want to retry on all response codes that indicate HTTP errors (4xx and 5xx) then combine with --fail.",
      "quote_sha256": "0f5d2d625064d32159494ade41fa12fea39c28a5c8af6085ef19779afcae7bd9",
      "locator": "docs/cmdline-opts/retry-all-errors.md normalized_UTF8_bytes[1231,1753)",
      "context_summary": "curl8.10.1 --retry-all-errors manual: companion option, redirected-IO cautions and HTTP-status versus transfer-error distinction.",
      "origin_group": "upstream:curl/curl",
      "scope": {
        "product": "curl",
        "release": "8.10.1"
      },
      "reference_facts": {
        "curl.retry_all.http404": "A fully received HTTP404 is not by itself a transfer error; --fail changes HTTP error treatment."
      },
      "synthetic_mutation": false
    }
  },
