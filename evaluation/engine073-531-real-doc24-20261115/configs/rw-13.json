              "id": "snapshot:rw-13:1",
              "observation": "{\"context_summary\": \"OpenSSL3.0.15 verification flags and callbacks: preserve client/server and built-in/custom verification contexts.\", \"document_id\": \"openssl-2\", \"locator\": \"doc/man3/SSL_CTX_set_verify.pod normalized_UTF8_bytes[4585,4892)\", \"origin_group\": \"upstream:openssl/openssl\", \"quote\": \"B<Client mode:> the server certificate is verified. If the verification process fails, the TLS/SSL handshake is immediately terminated with an alert message containing the reason for the verification failure. If no server certificate is sent, because an anonymous cipher is used, SSL_VERIFY_PEER is ignored.\", \"scope\": {\"product\": \"openssl\", \"release\": \"3.0.15\"}, \"source_version\": \"sha256:aa91cd752b21cc624f9c613246f0d2eb73635d8e4b6676d432147b6697be7cde\", \"synthetic_mutation\": false, \"url\": \"https://raw.githubusercontent.com/openssl/openssl/c523121f902fde2929909dc7f76b13ceb4961efe/doc/man3/SSL_CTX_set_verify.pod\"}",
