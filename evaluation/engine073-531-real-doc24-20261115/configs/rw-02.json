              "observation": "{\"context_summary\": \"curl8.10.1 --retry manual: transient errors, zero default retries, backoff and Retry-After history.\", \"document_id\": \"curl-1\", \"locator\": \"docs/cmdline-opts/retry.md normalized_UTF8_bytes[471,593)\", \"origin_group\": \"upstream:curl/curl\", \"quote\": \"Transient error means either: a timeout, an FTP 4xx response code or an HTTP 408, 429, 500, 502, 503 or 504 response code.\", \"scope\": {\"product\": \"curl\", \"release\": \"8.10.1\"}, \"source_version\": \"sha256:d164104079fbac52eefc1147bfb1eb152bfbb1d883e6c0f963df25a4e7a505e2\", \"synthetic_mutation\": false, \"url\": \"https://raw.githubusercontent.com/curl/curl/7eb8c048470ed2cc14dca75be9c1cdae7ac8498b/docs/cmdline-opts/retry.md\"}",
